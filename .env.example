# ===================== 阿里云百炼 API =====================
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# LLM (Qwen-Plus)
LLM_MODEL_NAME=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# VLM (Qwen-VL-Plus)
VLM_MODEL_NAME=qwen-vl-plus
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Embedding (text-embedding-v3)
EMBEDDING_MODEL_NAME=text-embedding-v3
EMBEDDING_DIMENSION=1024
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Rerank (gte-rerank)
RERANK_MODEL_NAME=gte-rerank

# 百炼 MCP 网络搜索
BAILIAN_MCP_APP_ID=your_app_id

# ===================== Milvus =====================
MILVUS_URL=http://localhost:19530
CHUNKS_COLLECTION=kb_chunks
ITEM_NAMES_COLLECTION=kb_item_names

# ===================== MinIO =====================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=kb-import-bucket
MINIO_SECURE=False
MINIO_PDF_DIR=pdf_files
MINIO_IMG_DIR=images

# ===================== MongoDB =====================
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=kb002

# ===================== Kafka =====================
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC=document-events
KAFKA_CONSUMER_GROUP=nexusrag-doc-sync

# ===================== MinerU PDF 解析 =====================
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_API_TOKEN=your_mineru_token

# ===================== 日志配置 =====================
LOG_CONSOLE_ENABLE=True
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLE=True
LOG_FILE_LEVEL=INFO
LOG_FILE_RETENTION=7 days
LOG_FILE_ENCODING=utf-8

# ===================== 缓存（演进8） =====================
EMBEDDING_CACHE_TTL_SECONDS=21600
HYDE_CACHE_TTL_SECONDS=3600
WEB_SEARCH_CACHE_TTL_SECONDS=1800
ALIGNMENT_CACHE_TTL_SECONDS=600

# ===================== Kafka 事件可靠性（演进6） =====================
KAFKA_DLQ_TOPIC=document-events-dlq
KAFKA_EVENT_RETRY_MAX=3
KAFKA_EVENT_RETRY_DELAY_SECONDS=5
EVENT_DEDUP_TTL_DAYS=7

# ===================== MongoDB 连接（演进3） =====================
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
